# Copy to .env — everything here is OPTIONAL. Without any of it the app still
# records and transcribes fully locally; notes just contain no AI summary
# unless Ollama is running.

# Summaries via Claude when no local Ollama model is available.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Local summaries via Ollama (https://ollama.com). If Ollama is running, it is
# always preferred over the API. Leave OLLAMA_MODEL empty to auto-pick.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_URL=http://127.0.0.1:11434

# Whisper model file inside ./whisper (download with: npm run setup).
# Use ggml-small.bin for much faster (slightly less accurate) transcription:
#   powershell -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1 -Model small
# WHISPER_MODEL=ggml-medium.bin
